<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作提醒器" Width="1160" Height="750" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#202D2B">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#17755D"/>
    <Style TargetType="Button">
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="#F5F7F6"/><Setter Property="Foreground" Value="#263D35"/>
      <Setter Property="BorderBrush" Value="#DCE3DF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D7DFDC"/><Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,16,0,7"/><Setter Property="Foreground" Value="#65746E"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F5F7F6"/><Setter Property="Foreground" Value="#65746E"/>
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E7F2EC"/><Setter Property="Foreground" Value="#194D3C"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="MinHeight" Value="62"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#EDF0EE"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E7F2EC"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
    <Border Background="#F4F7F5" BorderBrush="#E4EAE6" BorderThickness="0,0,1,0">
      <Grid Margin="18,26,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#17755D" Margin="4,0,0,13"/>
          <TextBlock Text="工作提醒器" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="DateLabel" Foreground="#78847F" Margin="0,9,0,28" FontSize="11"/>
          <TextBlock Text="当前项目" Foreground="#65746E" FontSize="12" Margin="0,0,0,7"/>
          <ComboBox x:Name="ProjectList" Height="34" AutomationProperties.Name="当前项目"/>
          <StackPanel Orientation="Horizontal" Margin="0,7,0,6">
            <Button x:Name="NewProjectButton" Content="新建项目" Height="28" Padding="7,0" ToolTip="新建项目"/>
            <Button x:Name="EditProjectButton" Content="编辑项目" Height="28" Padding="7,0" Margin="6,0,0,0" ToolTip="编辑当前项目"/>
          </StackPanel>
          <Button x:Name="DeleteProjectButton" Content="删除空项目" Height="28" Padding="7,0" Margin="0,0,0,18" ToolTip="仅能删除没有当前或归档事项的项目" AutomationProperties.Name="删除空项目"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="TodayButton" Content="今日待办" Style="{StaticResource Nav}"/>
          <Button x:Name="AllButton" Content="全部待办" Style="{StaticResource Nav}"/>
          <Button x:Name="PendingButton" Content="待安排下一步" Style="{StaticResource Nav}"/>
          <Button x:Name="CompletedButton" Content="已完成" Style="{StaticResource Nav}"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <CheckBox x:Name="SoundCheck" Content="提醒声音" Margin="0,0,0,15"/>
          <CheckBox x:Name="StartupCheck" Content="开机启动" Margin="0,0,0,20"/>
          <Border BorderBrush="#DDE5DF" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
              <TextBlock Text="●  提醒运行中" Foreground="#17755D" FontSize="12" VerticalAlignment="Center"/>
              <Button x:Name="ExitButton" Grid.Column="1" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="退出程序并停止提醒" AutomationProperties.Name="退出程序"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Button>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="26,28,24,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="ViewTitle" Text="今日待办" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SummaryLabel" Foreground="#78847F" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="ExportSettingsButton" Content="导出设置" AutomationProperties.Name="导出设置" Margin="0,0,8,0" ToolTip="设置 PBC 汇报周期"/>
          <Button x:Name="ExportButton" Content="导出 PBC" AutomationProperties.Name="导出 PBC" Margin="0,0,8,0" ToolTip="导出当前项目或全部项目 PBC 汇报"/>
          <Button x:Name="NewButton" Style="{StaticResource Primary}" ToolTip="新增工作提醒">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="新增"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,25,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Height="36" ToolTip="搜索任务或备注" AutomationProperties.Name="搜索任务"/>
        <TextBlock Text="搜索任务" Foreground="#9BA6A0" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button x:Name="DoneButton" Grid.Column="1" Width="36" Padding="0" Margin="8,0,0,0" ToolTip="完成所选任务" AutomationProperties.Name="完成所选任务"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
        <Button x:Name="SnoozeButton" Grid.Column="2" Width="36" Padding="0" Margin="8,0,0,0" ToolTip="所选任务延后 10 分钟" AutomationProperties.Name="延后所选任务"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
      </Grid>
      <Grid Grid.Row="2">
        <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowHeaderWidth="0" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="完成" Width="54">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Task.IsCompleted, Mode=OneWay}" ToolTip="标记本项完成或恢复" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="本项是否完成"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="工作事项" Width="*" MinWidth="100" SortMemberPath="Title">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="0,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#819087" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="提醒时间" Width="120" SortMemberPath="DueAt">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DueLabel}" FontSize="12"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="10,25,10,0">
          <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#A4B9AC" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyLabel" Text="今天暂无待办" FontSize="16" Foreground="#7D8E83" Margin="0,20,0,0" TextAlignment="Center"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="StatusLabel" Grid.Row="3" Foreground="#6D7B73" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap" MinHeight="18"/>
    </Grid>
    <Border Grid.Column="2" Background="#FAFBFA" BorderBrush="#E4EAE6" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="23,30,23,24">
          <TextBlock x:Name="EditorHeading" Text="新增提醒" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="ProjectHint" Foreground="#17755D" FontSize="12" TextWrapping="Wrap"/>
          <ComboBox x:Name="ProjectInput" Margin="0,8,0,0" DisplayMemberPath="Name" AutomationProperties.Name="新事项所属项目" Visibility="Collapsed"/>
          <Button x:Name="MoveProjectButton" Content="移动整条工作链到其他项目" Height="28" Padding="8,0" Margin="0,8,0,0" ToolTip="将当前事项及所有关联步骤一起移动项目"/>
          <TextBlock Text="工作事项" Style="{StaticResource Label}"/>
          <TextBox x:Name="TitleInput" MaxLength="200" Height="62" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="工作事项"/>
          <TextBlock Text="提醒日期与时间" Style="{StaticResource Label}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
            <DatePicker x:Name="DateInput" Height="34" SelectedDateFormat="Short" VerticalContentAlignment="Center" AutomationProperties.Name="提醒日期"/>
            <TextBox x:Name="TimeInput" Grid.Column="1" Margin="8,0,0,0" MaxLength="5" ToolTip="24 小时制，如 09:30" AutomationProperties.Name="提醒时间"/>
          </Grid>
          <TextBlock Text="重复" Style="{StaticResource Label}"/>
          <ComboBox x:Name="RepeatInput" AutomationProperties.Name="重复规则"><ComboBoxItem Content="不重复" Tag="once"/><ComboBoxItem Content="每天" Tag="daily"/><ComboBoxItem Content="周一至周五" Tag="weekdays"/><ComboBoxItem Content="每周" Tag="weekly"/></ComboBox>
          <TextBlock Text="优先级" Style="{StaticResource Label}"/>
          <ComboBox x:Name="PriorityInput" AutomationProperties.Name="优先级"><ComboBoxItem Content="普通" Tag="normal"/><ComboBoxItem Content="重要" Tag="high"/></ComboBox>
          <TextBlock Text="备注" Style="{StaticResource Label}"/>
          <TextBox x:Name="NotesInput" Height="110" MaxLength="10000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="备注"/>
          <TextBlock Text="计划完成日期（可选）" Style="{StaticResource Label}"/>
          <DatePicker x:Name="TargetDateInput" Height="34" SelectedDateFormat="Short" VerticalContentAlignment="Center" AutomationProperties.Name="计划完成日期"/>
          <TextBlock Text="实际成果（完成后填写）" Style="{StaticResource Label}"/>
          <TextBox x:Name="OutcomeInput" Height="70" MaxLength="10000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="实际成果"/>
          <TextBlock Text="成果依据（可选）" Style="{StaticResource Label}"/>
          <TextBox x:Name="EvidenceInput" Height="55" MaxLength="5000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="成果依据"/>
          <TextBlock Text="工作链操作" Style="{StaticResource Label}"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="NextStepButton" Content="添加下一步" Padding="8,0" ToolTip="为已完成事项创建关联下一步"/>
            <Button x:Name="CloseWorkflowButton" Content="没有后续，闭环" Padding="8,0" Margin="8,0,0,0" ToolTip="明确结束当前工作链"/>
          </StackPanel>
          <Button x:Name="EndRepeatButton" Content="结束重复并闭环" Margin="0,8,0,0" ToolTip="取消尚未编辑的自动重复下一次，保留此前的完成记录" Visibility="Collapsed"/>
          <TextBlock Text="工作链历史" Style="{StaticResource Label}"/>
          <TextBlock x:Name="WorkflowHistory" Foreground="#65746E" TextWrapping="Wrap"/>
          <TextBlock x:Name="ErrorLabel" Foreground="#BB4841" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <Button x:Name="SaveButton" Content="保存提醒" Style="{StaticResource Primary}"/>
            <Button x:Name="DeleteButton" Grid.Column="1" Margin="8,0,0,0" Padding="0" ToolTip="删除所选任务" Foreground="#B54B48" AutomationProperties.Name="删除所选任务"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/></Button>
          </Grid>
          <Button x:Name="CancelButton" Content="取消编辑" Margin="0,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
